              "end_row_offset_idx": 2,
              "start_col_offset_idx": 1,
              "end_col_offset_idx": 2,
              "text": "CNC 的总线上 发生了问题。",
              "column_header": false,
              "row_header": false,
              "row_section": false,
              "fillable": false
            },
            {
