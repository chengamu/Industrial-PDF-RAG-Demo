              "start_row_offset_idx": 1,
              "end_row_offset_idx": 2,
              "start_col_offset_idx": 2,
              "end_col_offset_idx": 3,
              "text": "可能是由于印刷板 的不良或外来噪声 的影响所致。",
              "column_header": false,
              "row_header": false,
              "row_section": false,
              "fillable": false
